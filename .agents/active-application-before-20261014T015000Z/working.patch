riginal_title":"SECTION 322 — Availability Management","original_status":"CONTENT-COMPLETE","applicability":"DIRECT","implementation_status":"NOT_STARTED","conformance_status":"NOT_EVALUATED","reconciliation_instruction":"Read original applicability/prerequisites and map its applicable clauses to exact CETA requirements before coding the affected work package.","volume":10,"volume_pdf":"sources/codex/Thirstys_Codex_Standards_Edition_Volume_10_Production_Operations_and_Command.pdf","original_required_outcome":"An availability model with service, critical journey, window, objective, dependency, redundancy, maintenance, monitoring, incident, recovery, and evidence.","original_applicability":"Apply when service access, continuity, user journey, dependency, maintenance, or recovery is material.","original_non_applicability":null,"requirement_ids":["REQ-08-01","REQ-30-01","REQ-30-04","REQ-32-04","REQ-35-02","REQ-37-02","REQ-37-04","REQ-41-04","REQ-04-02","REQ-19-01","REQ-29-01","REQ-36-01","REQ-36-04","REQ-37-01","REQ-40-01"],"decision_reason":"The declared persistent native Windows product and its required capability, delivery and recovery lifecycle have these bounded operational responsibilities. Define exact service/journeys/users/windows/objectives, dependency/redundancy/maintenance/degradation, access and accessibility, signals/incidents/support and recovery. Qualify partial failures and alternate paths against user outcomes, safety/privacy/data correctness and cost. Never trade mandatory controls for uptime or equate ping/process health with usable availability.","inspection_evidence_refs":["handoff/source_reconciliation_20261008_16.md","handoff/volumes_x_xi_xii_reconciliation_20261008_16.json",".local-build-cache/working-increment-16/read_receipt.json"]},{"original_archive_path":"Thirstys Codex/03_SECTIONS/323_PERFORMANCE_MANAGEMENT.txt","path":"sources/codex/canonical_text/03_SECTIONS/323_PERFORMANCE_MANAGEMENT.txt","sha256":"4e139eb41371823582330c91e30ab2286b86a7