+            dispatch_admitted=self.dispatch_admitted, stopped=False,
+            native_effect='UNESTABLISHED_BY_ADMISSION', denied_dispatch=self.denied)
+    @contextmanager
+    def recover_outcome(self, context):
+        self.recoveries += 1
