+"""Explicit same-owner CPU composition; configuration is never request data.
+
+The caller retains the clock, code manifest, observer, registry and journal.
+This owner retains only the view's file pins and native approval session. It
+creates no authority, worker, ceremony, scheduler or independent durable state.
+"""
+from dataclasses import dataclass
+from pathlib import Path
+import threading
+
+from ceta.composition.kernel_service import compose_kernel
+from ceta.composition.native_cpu_outcome import NativeCpuOutcomeAdapter
+from ceta.contracts.kernel_transactions import commitment, identifier, require
+from ceta.contracts.store_transactions import STORE_PROFILE
+from ceta.contracts.temporal import require_clock_progress
+from ceta.contracts.wire import ContractError, RecordCodec
+from ceta.effects.native_observer import NativeCpuEffectObserver
+from ceta.identity.native_clock import NativeSessionClock
+from ceta.identity.native_approval import NativeApprovalOwner
+from ceta.identity.native_code_binding import NativeCodeBinding
+from ceta.identity.native_owner_view import NativeOwnerView, NativeStoreBinding
+from ceta.identity.owner_session import NativeCpuOwnerSession
+from ceta.identity.windows_pipe import WindowsPeerRegistry
+from ceta.kernel.cpu_execution import _RetainedCpuExecution
+from ceta.store.journal import SqliteJournal
+from ceta.store.outcome_capacity import OutcomeCapacityBudget, OutcomeCapacityRuntime, _CapacityVfs
+
+
+@dataclass(frozen=True)
+class NativeCpuConfiguration:
+    """Concrete reviewed dependencies supplied by trusted process composition.
+
+    A configuration binds existing observed objects; it is not a qualification
+    flag. Pin names identify entries in the retained NativeCodeBinding. The
+    native owners continue to check actual platform, file and request facts.
+    """
+    clock: NativeSessionClock
+    code_binding: NativeCodeBinding
+    outcome_runtime: OutcomeCapacityRuntime
+    outcome_budget: OutcomeCapacityBudget
+    observer: NativeCpuEffectObserver
+    scope_id: str
+    policy_commitment: str
+    helper_name: str
+    helper_source_name: str
+    worker_name: str
+    observer_name: str
+    observer_source_name: str
+    capacity_helper_name: str
+
+    def __post_init__(self):
+        require(type(self.clock) is NativeSessionClock
+            and type(self.code_binding) is NativeCodeBinding
+            and type(self.outcome_runtime) is OutcomeCapacityRuntime
+            and type(self.outcome_budget) is OutcomeCapacityBudget
+            and type(self.observer) is NativeCpuEffectObserver,
+            'NATIVE_CPU_CONCRETE_DEPENDENCIES_REQUIRED')
+        require(self.observer._clock is self.clock, 'NATIVE_CPU_CLOCK_BINDING_REQUIRED')
+        identifier(self.scope_id)
+        commitment(self.policy_commitment)
+        self.outcome_budget.__post_init__()
+        names = (self.helper_name, self.helper_source_name, self.worker_name,
+            self.observer_name, self.observer_source_name, self.capacity_helper_name)
+        require(all(type(name) is str and 0 < len(name) <= 512 for name in names)
+            and len(set(names)) == len(names), 'NATIVE_CPU_MANIFEST_NAMES_REQUIRED')
+
+    def require_current(self):
+        """Check retained native files and one actual same-clock observation."""
+        self.__post_init__()
+        rows = NativeCodeBinding.snapshot(self.code_binding)
+        files = self.code_binding._files
+
+        def selected(group, name):
+            matches = [row for row in rows if row[0] == group and row[1] == name]
+            retained = [row for row in files if row['group'] == group
+                and row['logical_name'] == name]
+            require(len(matches) == len(retained) == 1,
+                'NATIVE_CPU_RETAINED_MANIFEST_ENTRY_REQUIRED')
+            require(matches[0][2] == retained[0]['sha256'],
+                'NATIVE_CPU_RETAINED_MANIFEST_CHANGED')
+            return Path(retained[0]['path']), matches[0][2]
+
+        selected('environment', self.helper_name)
+        selected('source', self.helper_source_name)
+        selected('environment', self.worker_name)
+        observer, image = selected('environment', self.observer_name)
+        driver, driver_sha = selected('source', self.observer_source_name)
+        capacity, capacity_sha = selected('environment', self.capacity_helper_name)
+        # These source paths come from the actual imported driver, not a caller
+        # digest or another copy of a source file with the same basename.
+        import ceta.effects.native_observer as native_observer
+        require(observer == Path(self.observer._executable)
+            and image == self.observer._image
+            and driver == Path(native_observer.__file__).resolve()
+            and driver_sha == self.observer._driver_sha,
+            'NATIVE_CPU_OBSERVER_MANIFEST_MISMATCH')
+        require(capacity == self.outcome_runtime.path
+            and capacity_sha == self.outcome_runtime.sha256,
+            'NATIVE_CPU_CAPACITY_MANIFEST_MISMATCH')
+        previous, current = NativeSessionClock.clock(self.clock)
+        require_clock_progress(previous, current)
+
+
+def _retain(primary, runtime, secondary=None):
+    data = BaseException.__dict__['__dict__'].__get__(primary)
+    dict.update(data, native_cpu_runtime=runtime,
+        native_cpu_runtime_cleanup=runtime.close)
+    if secondary is not None:
+        previous = dict.get(data, 'native_cpu_runtime_cleanup_errors', ())
+        if type(previous) is not tuple:
+            previous = ()
+        dict.__setitem__(data, 'native_cpu_runtime_cleanup_errors', previous + (secondary,))
+
+
+class NativeCpuRuntime:
+    """One captured kernel/owner/view over the supplied canonical journal."""
+    def __init__(self, store, codec, installation_scope_id, registry, configuration):
+        self._thread = threading.get_ident()
+        self._state = 'BUILDING'
+        self._store, self._codec, self._installation = store, codec, installation_scope_id
+        self._registry, self._configuration = registry, configuration
+        self._binding = self._view = self._owner = None
+        self.kernel = self.outcome_adapter = None
+        self._owner_ready = False
