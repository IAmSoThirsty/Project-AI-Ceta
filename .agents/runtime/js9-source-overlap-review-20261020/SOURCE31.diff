+@dataclass(frozen=True, slots=True)
+class _DeniedDispatch(_NoCopy):
+    execution: object
+    effect: object
+    target: object
+    arguments: tuple
+    request_wire: bytes
+    permit_wire: bytes
+    attempt_wire: bytes
+    context: object
+    thread: int
+    primary: BaseException
